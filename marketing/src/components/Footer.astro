---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface">
	<div class="container-main section-pad !py-14">
		<div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
			<div>
				<p class="text-lg font-bold text-ink">{site.name}</p>
				<p class="mt-2 max-w-xs text-sm text-ink-muted">{site.tagline}</p>
			</div>
			<div class="flex gap-12 text-sm">
				<ul class="space-y-2 text-ink-muted">
					<li><a href="/#fitur" class="hover:text-ink">Fitur</a></li>
					<li><a href="/harga" class="hover:text-ink">Harga</a></li>
					<li><a href={site.registerUrl} class="hover:text-ink">Daftar / Trial gratis</a></li>
				</ul>
				<div>
					<p class="font-medium text-ink">Kontak</p>
					<a href={`mailto:${site.contactEmail}`} class="mt-2 block text-ink-muted hover:text-brand-800">
						{site.contactEmail}
					</a>
				</div>
			</div>
		</div>
		<p class="mt-12 text-center text-xs text-ink-faint">© {year} {site.name}</p>
	</div>
</footer>
