---
import Button from '../ui/Button.astro';
import { site } from '../../config/site';
import { formatRupiah, getYearlyPricing, yearlyDiscountPercent } from '../../config/pricing';
import type { pricingTiers } from '../../config/pricing';

type Tier = (typeof pricingTiers)[number];

interface Props {
	tier: Tier;
}

const { tier } = Astro.props;
const yearly = tier.monthlyIdr != null ? getYearlyPricing(tier.monthlyIdr) : null;
const isFeatured = tier.highlight;
const isCustom = 'contactOnly' in tier && tier.contactOnly;
---

<article
	class:list={[
		'pricing-card relative flex flex-col overflow-hidden rounded-2xl border bg-canvas',
		isFeatured ? 'pricing-card-featured border-brand-600 lg:-mt-2 lg:mb-2' : 'border-border',
		isCustom && 'border-dashed border-border-strong bg-surface/50',
	]}
>
	{
		isFeatured && (
			<div class="bg-brand-800 px-5 py-2 text-center text-xs font-bold uppercase tracking-wider text-white">
				Paling direkomendasikan
			</div>
		)
	}

	<div class:list={['flex flex-1 flex-col p-7 sm:p-8', isFeatured && !isCustom && 'pt-6']}>
		<div>
			<p class="text-xs font-semibold uppercase tracking-widest text-brand-700">{tier.tagline}</p>
			<h2 class="mt-2 text-2xl font-bold tracking-tight text-ink">{tier.name}</h2>
			<p class="mt-2 text-sm leading-relaxed text-ink-muted">{tier.desc}</p>
		</div>

		<div class="mt-8">
			{
				isCustom ? (
					<div>
						<p class="text-3xl font-bold tracking-tight text-ink">Custom</p>
						<p class="mt-1 text-sm text-ink-muted">Penawaran sesuai kebutuhan sekolah</p>
					</div>
				) : (
					<div>
						<p class="text-4xl font-bold tracking-tight text-ink">{formatRupiah(tier.monthlyIdr!)}</p>
						<p class="mt-1 text-sm text-ink-muted">per bulan · per sekolah</p>
						{yearly && (
							<div class="mt-4 rounded-xl border border-brand-100 bg-brand-50 px-4 py-3">
								<p class="text-xs font-semibold text-brand-800">
									Tahunan {formatRupiah(yearly.total)}
								</p>
								<p class="mt-0.5 text-xs text-ink-muted">
									Setara {formatRupiah(yearly.perMonth)}/bln · hemat {yearlyDiscountPercent}%
								</p>
							</div>
						)}
					</div>
				)
			}
		</div>

		<ul class="mt-8 flex-1 space-y-3 border-t border-border pt-8">
			{
				tier.features.map((f) => (
					<li class="flex gap-3 text-sm leading-snug text-ink-muted">
						<svg
							class="mt-0.5 h-4 w-4 shrink-0 text-brand-600"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2.5"
							aria-hidden="true"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
						</svg>
						<span>{f}</span>
					</li>
				))
			}
		</ul>

		{
			'notIncluded' in tier && tier.notIncluded && tier.notIncluded.length > 0 && (
				<div class="mt-6 rounded-xl bg-surface px-4 py-3">
					<p class="text-[11px] font-bold uppercase tracking-wider text-ink-faint">Belum termasuk</p>
					<ul class="mt-2 space-y-1">
						{tier.notIncluded.map((n) => (
							<li class="text-xs text-ink-faint">· {n}</li>
						))}
					</ul>
				</div>
			)
		}

		<div class="mt-8">
			{
				isCustom ? (
					<Button
						href={`mailto:${site.contactEmail}?subject=Plus%20AI%20%26%20Custom`}
						variant="outline"
						size="lg"
						class="w-full justify-center"
					>
						{tier.cta}
					</Button>
				) : (
					<Button
						href={`${site.registerUrl}?paket=${tier.id}`}
						variant={isFeatured ? 'primary' : 'outline'}
						size="lg"
						class="w-full justify-center"
					>
						{tier.cta}
					</Button>
				)
			}
		</div>
	</div>
</article>
