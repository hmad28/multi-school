---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';
import { pricingTiers, formatRupiah } from '../config/pricing';

const paket = Astro.url.searchParams.get('paket');
const billing = Astro.url.searchParams.get('billing');
const selectedTier = pricingTiers.find((t) => t.id === paket);

// Registration is handled by the Laravel app (Inertia form + email verification).
// Forward any plan/billing selection so the app form can pre-select it.
const params = new URLSearchParams();
if (paket) params.set('paket', paket);
if (billing) params.set('billing', billing);
const registerHref = params.toString() ? `${site.registerUrl}?${params.toString()}` : site.registerUrl;
---

<MarketingLayout title="Daftar sekolah" description={`Daftar Platform Sekolah — trial ${site.trialDays} hari atau berlangganan.`}>
	<Header />
	<main class="section-pad">
		<div class="container-main grid gap-12 lg:grid-cols-5 lg:gap-16">
			<div class="lg:col-span-2">
				<SectionLabel>Daftar</SectionLabel>
				<h1 class="text-section mt-4 text-ink">Daftarkan sekolah Anda</h1>
				{
					selectedTier ? (
						<p class="mt-4 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-900">
							Paket: <strong>{selectedTier.name}</strong>
							{selectedTier.monthlyIdr != null && (
								<span> — mulai {formatRupiah(selectedTier.monthlyIdr)}/bulan setelah trial</span>
							)}
						</p>
					) : (
						<p class="mt-4 text-ink-muted">
							Mulai <strong class="text-ink">trial {site.trialDays} hari gratis</strong>, lalu pilih Standar, Plus
							AI, atau hubungi kami untuk paket Custom.
						</p>
					)
				}
				<p class="mt-8 text-sm text-ink-muted">
					<a href={`mailto:${site.contactEmail}`} class="font-semibold text-brand-800 hover:underline">
						{site.contactEmail}
					</a>
				</p>
			</div>

			<div
				class="rounded-[var(--radius-card)] border border-border bg-canvas p-6 shadow-[0_8px_30px_-12px_rgba(15,23,42,0.12)] sm:p-8 lg:col-span-3"
			>
				<h2 class="text-xl font-semibold text-ink">Buat akun sekolah</h2>
				<p class="mt-2 text-sm text-ink-muted">
					Pendaftaran dilakukan di aplikasi Platform Sekolah. Anda akan mengisi nama sekolah, data admin (PIC),
					dan memverifikasi email sebelum masuk ke onboarding.
				</p>
				<ul class="mt-6 space-y-3 text-sm text-ink">
					<li class="flex gap-3"><span class="font-bold text-brand-700">1.</span> Isi nama sekolah & data admin</li>
					<li class="flex gap-3"><span class="font-bold text-brand-700">2.</span> Verifikasi email PIC</li>
					<li class="flex gap-3"><span class="font-bold text-brand-700">3.</span> Onboarding: profil, tahun ajaran, kelas, siswa</li>
					<li class="flex gap-3"><span class="font-bold text-brand-700">4.</span> Trial {site.trialDays} hari langsung aktif</li>
				</ul>
				<div class="mt-8">
					<Button href={registerHref} variant="primary" size="lg">Lanjut ke pendaftaran</Button>
				</div>
				<p class="mt-4 text-xs text-ink-muted">{site.existingClientHint}</p>
			</div>
		</div>
	</main>
	<Footer />
</MarketingLayout>
